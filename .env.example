# Copy to .env (git-ignored) and fill in your own values.
# Any role that can create schemas, stages, tables and views in the database works.

SNOWFLAKE_ACCOUNT=<orgname-accountname>
SNOWFLAKE_USER=<you@example.com>
# externalbrowser = SSO login in your browser; use "snowflake" together with SNOWFLAKE_PASSWORD otherwise
SNOWFLAKE_AUTHENTICATOR=externalbrowser
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=<role>
SNOWFLAKE_WAREHOUSE=<warehouse>
SNOWFLAKE_DATABASE=<database>

# Schema holding the raw loaded files
SNOWFLAKE_RAW_SCHEMA=RAW_NYC_TAXI_<INITIALS>
# Schema dbt builds into
SNOWFLAKE_SCHEMA=DBT_NYC_TAXI_<INITIALS>
